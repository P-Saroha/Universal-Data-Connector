
# Universal Data Connector - Environment Configuration
# Copy this file to .env and fill in your values.

# --- Application ---
APP_NAME=Universal Data Connector
APP_VERSION=1.0.0
DEBUG=false

# --- Voice / Result Limits ---
MAX_VOICE_RESULTS=10
DEFAULT_PAGE_SIZE=20

# --- LLM / Google Gemini ---
GOOGLE_API_KEY=your-google-api-key-here
GOOGLE_MODEL=gemini-2.5-flash

# --- Server ---
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
